{
  "manifest_version": 3,
  "name": "Breadcrumbs Browser Bridge",
  "description": "Share the active normal Chrome tab with a paired, local Breadcrumbs focus session.",
  "version": "0.4.5",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Breadcrumbs Browser Bridge", "default_popup": "popup.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
